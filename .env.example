# ---------------------------------------------------------------------------
# STATUS (verified against a real Okta trial + a real deployed Zuplo gateway):
# Login and ID-JAG *issuance* work end-to-end — confirmed via Okta's own
# System Log showing `app.oauth2.token.grant.id_jag | SUCCESS`. ID-JAG
# *redemption* (Leg 3) hit a real gap in @zuplo/runtime's
# mcp-token-exchange-inbound policy (not an Okta config issue, and NOT an
# entitlement/subscription gap — verified both). Worked around it with a
# small stripping proxy in this project (modules/basic-api-token-proxy.ts) —
# mechanically confirmed it correctly reaches real Okta; final live
# end-to-end confirmation still pending (blocked mid-session by an unrelated
# Okta sign-in widget stall, not by the proxy). See README.md for the full
# trace.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Okta org — bare hostname, no scheme, no trailing slash, no path.
# ---------------------------------------------------------------------------
OKTA_DOMAIN=your-tenant.okta.com

# ---------------------------------------------------------------------------
# Leg 1 — inbound browser login (mcp-okta-oauth-inbound / McpOktaOAuthInboundPolicy)
# ---------------------------------------------------------------------------
# Okta Admin Console > Applications > Create App Integration
#   Sign-in method: OIDC - OpenID Connect
#   Application type: Web Application
#   Grant type: Authorization Code (leave the rest at their defaults)
#   Sign-in redirect URI:
#     Local dev:   http://localhost:9000/__zuplo/oauth/callback
#     Deployed:    https://<gateway-host>/__zuplo/oauth/callback
#   Assign this app to whichever Okta group/users should be able to reach the
#   gateway at all (this is the *authentication* gate; role/tool gating is
#   handled separately by the tool-rbac policy below).
#
# Do NOT set `authorizationServerId` on the okta-inbound-oauth policy in
# policies.json — omit it entirely. ID-JAG issuance (Leg 2) only works
# against Okta's true *org* authorization server, and the subject token used
# there must have been issued by that same org AS — so login has to go
# through it too, not a custom AS (even one named "default"). This directly
# contradicts what you might expect from the McpOktaOAuthInboundPolicy type
# docs' phrasing around custom-AS claims support; verified empirically by
# switching between the two and reading Okta's own System Log requestUri for
# each hop.
OKTA_GATEWAY_CLIENT_ID=
OKTA_GATEWAY_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Register this same app as an AI Agent for Cross App Access
# ---------------------------------------------------------------------------
# Directory > AI Agents > Register AI agent. On "User access and
# authentication", choose "Select an existing app" and pick the Leg 1 app
# above (NOT a separate app — this matters). Okta will auto-add the
# `urn:ietf:params:oauth:grant-type:token-exchange` and
# `urn:ietf:params:oauth:grant-type:jwt-bearer` grant types to this app for
# you. This is also why Leg 2 below reuses OKTA_GATEWAY_CLIENT_ID/SECRET
# rather than a separate app — the registered agent's own identity is what
# Okta expects to see authenticating the ID-JAG request; a different,
# unregistered client gets a generic `invalid_requested_token_type` even
# with an otherwise-correct request.

# ---------------------------------------------------------------------------
# Tool RBAC (mcp-capability-filter-inbound) — currently fails closed
# ---------------------------------------------------------------------------
# config/policies.json gates the `echo-get` tool behind an Okta role/group
# claim named `mcp-user` (see policies.json > tool-rbac). This claim was
# previously added on the "default" custom authorization server — but now
# that login (per Leg 1's note above) must go through the org authorization
# server instead, that claim configuration no longer applies, and the org AS
# doesn't support the same custom-claims API custom authorization servers do.
# Net effect: as configured, nobody currently satisfies the `mcp-user` role
# check, so every call is blocked (fails closed — not a security hole, but
# not usable either). This needs a different mechanism to re-add real RBAC
# once Leg 3 below is unblocked — e.g. a claim added via a different
# Okta-side mechanism compatible with the org AS, or a custom Zuplo policy
# that looks up group membership directly via the Okta Users API instead of
# reading it off the token.

# ---------------------------------------------------------------------------
# Leg 2 — ID-JAG issuance (okta-upstream-token-exchange > idJag.idp)
# ---------------------------------------------------------------------------
# The actual RFC 8693-style token-exchange leg: the gateway presents the
# caller's Okta ID token (from Leg 1's login) and asks Okta's *org*
# authorization server to mint an ID-JAG
# (requested_token_type=urn:ietf:params:oauth:token-type:id-jag). Confirmed
# working — Okta's System Log shows `app.oauth2.token.grant.id_jag |
# SUCCESS` for this exact call.
#
# Token endpoint — the org AS, no authServerId segment:
#   https://${OKTA_DOMAIN}/oauth2/v1/token
OKTA_IDJAG_TOKEN_URL=https://your-tenant.okta.com/oauth2/v1/token

# No separate client here — this leg authenticates as the SAME app as Leg 1
# (client_secret_basic, using OKTA_GATEWAY_CLIENT_ID/SECRET above), because
# that's the client Okta registered as the AI agent. Do not create/use a
# separate "ID-JAG issuer" app for this — it will authenticate fine at the
# OAuth level but Okta won't recognize it as the agent, and every request
# will fail with `invalid_requested_token_type` regardless of how correctly
# everything else is configured.

# ---------------------------------------------------------------------------
# Leg 3 — ID-JAG redemption (okta-upstream-token-exchange > idJag.resourceAs)
# ---------------------------------------------------------------------------
# WORKAROUND IN PLACE for a real @zuplo/runtime gap: the runtime's jwt-bearer
# redemption request unconditionally includes a `scope` parameter — sourced
# from whatever scope Okta's own ID-JAG issuance response granted, which is
# always populated regardless of whether idJag.scopes is set on our side —
# and Okta rejects that with `id_jag_scopes_in_request` on every attempt
# (confirmed via Okta's System Log). Okta's own documented redemption
# request (see "Set up AI agent token exchange" guide) shows no `scope`
# parameter at all — the grant is implied by the assertion itself. There's
# no policies.json option to suppress it, so `OKTA_RESOURCE_AS_TOKEN_URL`
# below points at `/internal/basic-api-token-proxy` — a route in THIS
# project (modules/basic-api-token-proxy.ts) that sits between the runtime
# and Okta, strips the `scope` form field, and forwards everything else to
# the real Okta endpoint (REAL_OKTA_RESOURCE_AS_TOKEN_URL, below). Mechanically
# verified the proxy correctly reaches real Okta (a synthetic request
# through it gets a genuine Okta error back, not a local one). Still needs a
# final live end-to-end confirmation via a real browser login — blocked
# mid-session by an unrelated Okta sign-in widget stall, not by anything in
# the proxy itself.
#
# The Resource Authorization Server representing the downstream basic-api
# MCP server. Create a dedicated custom authorization server for it (Security
# > API > Authorization Servers > Add Authorization Server) rather than
# reusing "default" — its Audience field is what OKTA_RESOURCE_AS_AUDIENCE
# must match exactly (including a trailing slash if Okta added one).
#
# Real Okta token endpoint (what the proxy forwards to):
#   https://${OKTA_DOMAIN}/oauth2/${authServerId}/v1/token
REAL_OKTA_RESOURCE_AS_TOKEN_URL=https://your-tenant.okta.com/oauth2/YOUR_AUTH_SERVER_ID/v1/token

# What the mcp-token-exchange-inbound policy actually points at — this
# project's own stripping proxy, not Okta directly:
OKTA_RESOURCE_AS_TOKEN_URL=https://<this-gateway-host>/internal/basic-api-token-proxy

# The Audience value configured on that authorization server (Security > API
# > Authorization Servers > [server] > Settings > Audience) — NOT the
# basic-api URL itself, the Okta AS's own identifier.
OKTA_RESOURCE_AS_AUDIENCE=

# A dedicated API Services app, authorized on this Resource AS for the
# `urn:ietf:params:oauth:grant-type:jwt-bearer` grant type, with
# private_key_jwt client authentication — this authenticates fine (confirmed
# by Okta's log; the failure here is the scope parameter above, not this
# client's credentials).
OKTA_RESOURCE_CLIENT_ID=
OKTA_RESOURCE_PRIVATE_KEY_PEM=

# This authorization server also needs a `basic-api.read` scope defined
# (Security > API > Authorization Servers > [server] > Scopes) — the
# resource connection (Directory > AI Agents > [agent] > Resource
# connections) grants access to it, and Okta embeds it in the ID-JAG
# automatically regardless of what config/policies.json requests.

# ---------------------------------------------------------------------------
# Downstream MCP server this gateway fronts.
# ---------------------------------------------------------------------------
UPSTREAM_BASIC_API_MCP_URL=https://basic-api-main-cf106ad.zuplo.app/mcp
